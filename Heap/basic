# Heap / Priority Queue basic knowledge
#
# Heap is used when we need to repeatedly get the smallest or largest item.
#
# Python uses heapq.
# heapq is a min heap by default.
#
# Common operations:
#   heapq.heappush(heap, x)  # push x
#   heapq.heappop(heap)      # pop smallest x
#   heap[0]                  # peek smallest x
#
# Common use cases:
#   1. Top K smallest / largest
#   2. Kth largest / kth smallest
#   3. Merge k sorted lists
#   4. Meeting rooms / schedule problems
#   5. Dijkstra shortest path
#   6. Data stream median, usually with two heaps

import heapq


# --------------------
# 1. Min heap
# --------------------

heap = []

heapq.heappush(heap, 3)
heapq.heappush(heap, 1)
heapq.heappush(heap, 2)

smallest = heap[0]        # 1
first = heapq.heappop(heap)  # 1


# --------------------
# 2. Turn list into heap
# --------------------

nums = [5, 1, 8, 3, 2]
heapq.heapify(nums)

# nums is now a valid heap.
# nums[0] is the smallest value.


# --------------------
# 3. Max heap
# --------------------
#
# Python heapq does not have max heap by default.
# Use negative values.

max_heap = []

heapq.heappush(max_heap, -3)
heapq.heappush(max_heap, -1)
heapq.heappush(max_heap, -5)

largest = -heapq.heappop(max_heap)  # 5


# --------------------
# 4. Kth largest
# --------------------
#
# Keep a min heap of size k.
# The heap stores the current k largest numbers.
# heap[0] is the kth largest number.

def kth_largest(nums, k):
    heap = []

    for num in nums:
        heapq.heappush(heap, num)

        if len(heap) > k:
            heapq.heappop(heap)

    return heap[0]


# Time: O(n log k)
# Space: O(k)


# --------------------
# 5. Top k largest
# --------------------

def top_k_largest(nums, k):
    heap = []

    for num in nums:
        heapq.heappush(heap, num)

        if len(heap) > k:
            heapq.heappop(heap)

    return heap


