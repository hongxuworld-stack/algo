# --------------------
# 6. Heap with tuple
# --------------------
#
# Tuple is compared from left to right.
# This is useful when we need priority plus extra data.

tasks = []

heapq.heappush(tasks, (2, "clean"))
heapq.heappush(tasks, (1, "study"))
heapq.heappush(tasks, (3, "sleep"))

priority, task = heapq.heappop(tasks)  # (1, "study")


# --------------------
# 7. Two heaps for median
# --------------------
#
# left: max heap, stores smaller half, use negative values
# right: min heap, stores larger half
#
# Keep:
#   len(left) == len(right)
#   or len(left) == len(right) + 1

class MedianFinderBasic:
    def __init__(self):
        self.left = []
        self.right = []

    def add_num(self, num):
        heapq.heappush(self.left, -num)

        if self.left and self.right and -self.left[0] > self.right[0]:
            val = -heapq.heappop(self.left)
            heapq.heappush(self.right, val)

        if len(self.left) > len(self.right) + 1:
            val = -heapq.heappop(self.left)
            heapq.heappush(self.right, val)

        if len(self.right) > len(self.left):
            val = heapq.heappop(self.right)
            heapq.heappush(self.left, -val)

    def find_median(self):
        if len(self.left) > len(self.right):
            return -self.left[0]

        return (-self.left[0] + self.right[0]) / 2


# --------------------
# 8. Pattern summary
# --------------------
#
# Need smallest each time:
#   use min heap directly
#
# Need largest each time:
#   use max heap by pushing negative values
#
# Need kth largest:
#   keep min heap of size k
#
# Need kth smallest:
#   keep max heap of size k
#
# Need priority with extra information:
#   push tuple like (priority, index, value)
#
# Important:
#   heappush: O(log n)
#   heappop:  O(log n)
#   peek:     O(1)
#   heapify:  O(n)
