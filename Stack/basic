# --------------------
# 2. Valid parentheses template
# --------------------

def is_valid_parentheses(s):
    stack = []
    pairs = {
        ")": "(",
        "]": "[",
        "}": "{",
    }

    for ch in s:
        if ch in "([{":
            stack.append(ch)
        else:
            if not stack:
                return False
            if stack.pop() != pairs[ch]:
                return False

    return len(stack) == 0


# Time: O(n)
# Space: O(n)


# --------------------
# 3. Monotonic stack
# --------------------
#
# 单调栈不是一种新的数据结构，本质还是 stack。
# 区别是：stack 里面的元素会保持某种单调性。
#
# 常见问题：
#   1. next greater element
#   2. next smaller element
#   3. daily temperatures
#   4. largest rectangle in histogram
#
# 什么时候 pop？
#   当当前元素破坏 stack 的单调性时，就一直 pop。


def next_greater(nums):
    res = [-1] * len(nums)
    stack = []

    for i, num in enumerate(nums):
        while stack and nums[stack[-1]] < num:
            prev_i = stack.pop()
            res[prev_i] = num

        stack.append(i)

    return res


# Time: O(n)
# Space: O(n)
#
# 虽然有 while，但每个 index 最多进栈一次、出栈一次。
# 所以总时间复杂度是 O(n)，不是 O(n^2)。


