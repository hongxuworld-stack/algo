# Union Find / Disjoint Set Union basic knowledge


# Union Find is used to group nodes into connected components.
# Main operations:
# 1. find(x): find the root/parent of x
# 2. union(x, y): connect the group of x and the group of y
# 3. connected(x, y): check if x and y have the same root


# --------------------
# 1. Basic version
# --------------------


class UnionFindBasic:
    def __init__(self, n):
        self.parent = [i for i in range(n)]

    def find(self, x):
        while x != self.parent[x]:
            x = self.parent[x]
        return x

    def union(self, x, y):
        root_x = self.find(x)
        root_y = self.find(y)

        if root_x == root_y:
            return False

        self.parent[root_y] = root_x
        return True

    def connected(self, x, y):
        return self.find(x) == self.find(y)


# Example:
uf = UnionFindBasic(5)
uf.union(0, 1)
uf.union(1, 2)
print(uf.connected(0, 2))  # True
print(uf.connected(0, 4))  # False


# --------------------
# 2. Basic version with path compression
# --------------------
# Path compression makes every visited node point directly to the root.
# This makes future find calls much faster.


class UnionFindPathCompression:
    def __init__(self, n):
        self.parent = [i for i in range(n)]

    def find(self, x):
        if x != self.parent[x]:
            self.parent[x] = self.find(self.parent[x])
        return self.parent[x]

    def union(self, x, y):
        root_x = self.find(x)
        root_y = self.find(y)

        if root_x == root_y:
            return False

        self.parent[root_y] = root_x
        return True

    def connected(self, x, y):
        return self.find(x) == self.find(y)


# --------------------
# 3. Optimize union function
# --------------------
# Problem with basic union:
# If we always attach one root to another randomly, the tree can become tall.
#
# Better idea:
# Attach the smaller tree to the bigger tree.
# This is called union by size.


class UnionFindOptimized:
    def __init__(self, n):
        self.parent = [i for i in range(n)]
        self.size = [1 for _ in range(n)]
        self.count = n

    def find(self, x):
        if x != self.parent[x]:
            self.parent[x] = self.find(self.parent[x])
        return self.parent[x]

    def union(self, x, y):
        root_x = self.find(x)
        root_y = self.find(y)

        if root_x == root_y:
            return False

        if self.size[root_x] < self.size[root_y]:
            root_x, root_y = root_y, root_x

        self.parent[root_y] = root_x
        self.size[root_x] += self.size[root_y]
        self.count -= 1

        return True

    def connected(self, x, y):
        return self.find(x) == self.find(y)


# Example:
uf = UnionFindOptimized(5)
uf.union(0, 1)
uf.union(2, 3)
uf.union(1, 3)

print(uf.connected(0, 3))  # True
print(uf.connected(0, 4))  # False
print(uf.count)  # number of connected components


# Union by rank is another common optimization.
# Rank means approximate tree height.


class UnionFindRank:
    def __init__(self, n):
        self.parent = [i for i in range(n)]
        self.rank = [0 for _ in range(n)]

    def find(self, x):
        if x != self.parent[x]:
            self.parent[x] = self.find(self.parent[x])
        return self.parent[x]

    def union(self, x, y):
        root_x = self.find(x)
        root_y = self.find(y)

        if root_x == root_y:
            return False

        if self.rank[root_x] < self.rank[root_y]:
            self.parent[root_x] = root_y
        elif self.rank[root_x] > self.rank[root_y]:
            self.parent[root_y] = root_x
        else:
            self.parent[root_y] = root_x
            self.rank[root_x] += 1

        return True


# Summary:
# Basic Union Find:
#   find: walk up to the root
#   union: connect one root to another root
#
# Path Compression:
#   during find, make nodes point directly to the root
#
# Union Optimization:
#   union by size: attach smaller tree to bigger tree
#   union by rank: attach shorter tree to taller tree
#
# Best common version:
#   path compression + union by size/rank


# --------------------
# Time complexity
# --------------------
#
# n = number of nodes
# m = number of union/find operations
#
# Basic Union Find:
#   find(x):      O(n) worst case
#   union(x, y):  O(n) worst case, because it calls find twice
#   connected:    O(n) worst case, because it calls find twice
#
# With path compression only:
#   find(x):      faster over time, but a single call can still be O(n)
#   union(x, y):  faster over time, because find gets cheaper
#   connected:    faster over time
#
# With union by size/rank only:
#   find(x):      O(log n)
#   union(x, y):  O(log n)
#   connected:    O(log n)
#
# With both path compression and union by size/rank:
#   find(x):      almost O(1)
#   union(x, y):  almost O(1)
#   connected:    almost O(1)
#
# More formally, each operation is O(alpha(n)).
# alpha(n) is inverse Ackermann function.
# In LeetCode/interviews, you can usually say "almost constant time".
#
# Space complexity:
#   parent array: O(n)
#   size/rank:    O(n)
#   total:        O(n)
